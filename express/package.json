{
  "name": "express-practice",
  "version": "1.0.0",
  "description": "Express.js practice project with modern structure",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --watch --test test/**/*.test.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.js\"",
    "db:init": "node src/db/init.js"
  },
  "keywords": [
    "express",
    "practice",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "mongoose": "^9.8.1",
    "morgan": "^1.10.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3"
  }
}
